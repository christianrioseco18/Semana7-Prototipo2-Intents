<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ayuda" android:textSize="28sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cómo probar la aplicación" android:textSize="20sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Maps abre tu ubicación si ya la obtuviste. En caso contrario, muestra Santiago centro como ejemplo." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Web abre el sitio HTTPS configurado en Ajustes." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Teléfono abre el marcador. Tú decides si realizas la llamada." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4. Correo prepara un borrador. Tú decides si lo envías." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5. Galería devuelve una URI y muestra la imagen elegida." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="6. Segunda Vista recibe tu nombre y ubicación." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="7. Ajustes valida y guarda los campos." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="8. Ayuda muestra esta guía." android:textSize="18sp" android:layout_marginBottom="12dp"/><TextView  android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La linterna requiere flash y permiso de cámara. La ubicación requiere permiso y un proveedor activo. Si cancelas la galería, puedes seguir usando la app." android:textSize="18sp" android:layout_marginBottom="12dp"/><Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VOLVER" android:layout_marginTop="8dp"/></LinearLayout></ScrollView>